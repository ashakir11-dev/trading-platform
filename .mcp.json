{
  "mcpServers": {
    "equibles": {
      "type": "http",
      "url": "https://mcp.equibles.com/mcp",
      "headers": {"Authorization": "Bearer ${EQUIBLES_API_KEY}"}
    },
    "alpaca": {
      "command": "uvx",
      "args": ["alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_SECRET_KEY": "${ALPACA_SECRET_KEY}",
        "ALPACA_PAPER_TRADE": "true"
      }
    }
  }
}
