# Copy to .env (git-ignored) and fill in. `trading-agent` loads it; values already set in
# the environment win. ~/.trading-platform/env is read too, for keys kept outside the repo.

# Market data (Plus plan or better: a full run makes a few hundred calls).
EQUIBLES_API_KEY=

# Claude. Leave empty if you are logged in to Claude Code (`claude`, then /login).
ANTHROPIC_API_KEY=
